# Every text file is LF in the index and in every checkout, Windows included.
# The collection artifact is pinned by its hash, and a CRLF checkout of the same
# commit builds different bytes.
* text=auto eol=lf

# Preserve format-patch context markers and signature separators verbatim.
contributions/*.patch -whitespace

# Vendored upstream, pinned byte-identical: no end-of-line conversion, ever.
# Its provenance hash is checked in bootstrap.test.ts and CRLF would break it.
src/napplet/collection/vendor/nutft-wallet.js -text
