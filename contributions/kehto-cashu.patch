diff --git a/packages/runtime/src/cashu.test.ts b/packages/runtime/src/cashu.test.ts
new file mode 100644
index 00000000..720ed865
--- /dev/null
+++ b/packages/runtime/src/cashu.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it, vi } from 'vitest';
+import { createRuntime } from './runtime.js';
+import { createMockRuntimeAdapter, createNip5dSessionEntry } from './test-utils.js';
+
+describe('experimental Cashu capability', () => {
+  it('requires a source-bound session and permission, dispatches once granted, and redacts audits', () => {
+    const ctx = createMockRuntimeAdapter();
+    const runtime = createRuntime(ctx.hooks);
+    const handleMessage = vi.fn();
+    runtime.registerService('cashu', {
+      descriptor: { name: 'cashu', version: '1.0.0' },
+      handleMessage
+    });
+    const message = { type: 'cashu.request', id: 'one', request: { body: 'secret proof payload' } };
+    runtime.handleMessage('window', message);
+    expect(handleMessage).not.toHaveBeenCalled();
+    runtime.sessionRegistry.register(
+      'window',
+      createNip5dSessionEntry('window', 'bearlett', 'a'.repeat(64))
+    );
+    runtime.handleMessage('window', message);
+    expect(handleMessage).not.toHaveBeenCalled();
+    expect(ctx.sent.at(-1)?.message).toMatchObject({ type: 'cashu.request.result', ok: false });
+    runtime.aclState.grant('', 'bearlett', 'a'.repeat(64), 'cashu:request');
+    runtime.handleMessage('window', message);
+    expect(handleMessage).toHaveBeenCalledTimes(1);
+    expect(JSON.stringify(ctx.aclChecks)).not.toContain('secret proof');
+    runtime.handleMessage('window', { ...message, type: 'cashu.request.result' });
+    expect(handleMessage).toHaveBeenCalledTimes(1);
+  });
+  it('returns a correlated denial when permission exists but the service is missing', () => {
+    const ctx = createMockRuntimeAdapter();
+    const runtime = createRuntime(ctx.hooks);
+    runtime.sessionRegistry.register(
+      'window',
+      createNip5dSessionEntry('window', 'bearlett', 'a'.repeat(64))
+    );
+    runtime.aclState.grant('', 'bearlett', 'a'.repeat(64), 'cashu:request');
+    runtime.handleMessage('window', { type: 'cashu.acquire', id: 'one' });
+    expect(ctx.sent.at(-1)?.message).toMatchObject({
+      type: 'cashu.acquire.result',
+      id: 'one',
+      ok: false
+    });
+  });
+});
