{
  "name": "bearlett",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "Bearlett - an LNURLcash (LUD-25) wallet, built from the spec",
  "author": "Bearlett contributors; based on LNURLwallet by dni",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tsc": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:napplet": "vite build --config vite.napplet.config.mts",
    "check:napplets": "node scripts/check-napplet-meta.mjs",
    "test:conformance": "node scripts/conformance-all.mjs"
  },
  "dependencies": {
    "@napplet/sdk": "0.28.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "qr": "0.7.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "0.2.19",
    "@napplet/shim": "0.30.0",
    "@napplet/vite-plugin": "0.14.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BIMbeamFLX/bearlett.git"
  },
  "type": "module"
}
